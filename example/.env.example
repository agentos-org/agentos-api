# Copy this file to example/.env and fill in your own model endpoint.
#
# These names intentionally match liteagent_server_dart examples:
#   baseUrl = OpenAI-compatible LLM API base URL
#   apiKey  = API key for that endpoint
#   model   = upstream model name

baseUrl = https://api.openai.com/v1
apiKey = sk-your-api-key
model = gpt-4o-mini

# LiteAgent server URL used by agentkit_stream_callback_llm_example.dart.
# Start ../liteagent_server_dart/bin/server.dart before running that example.
liteAgentBaseUrl = http://127.0.0.1:9527/api/v1
